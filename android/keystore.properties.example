# Copy to android/keystore.properties and fill in. That file is gitignored --
# it holds signing credentials and must never be committed.
#
# The keystore itself is unrecoverable. Android only accepts an update signed by
# the same certificate, so losing the .jks means no future build can update an
# app anyone has already installed. Keep a backup somewhere the whole team can
# reach, outside the repository.
#
# storeFile is resolved relative to android/app/, so give it an absolute path to
# wherever you actually saved the .jks -- and keep that outside the repo tree.
# Use forward slashes even on Windows; a backslash is an escape character in a
# .properties file. Pointing this at a path that does not exist fails late, at
# :app:validateSigningRelease, not when Gradle reads this file.

storeFile=<absolute path to your .jks, e.g. D:/Android/keys/remindrx.jks>
storePassword=
keyAlias=remindrx
keyPassword=
