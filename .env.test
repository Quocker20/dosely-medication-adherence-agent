# Settings for the automated test suite ONLY. Every value is a dummy.
# Committed on purpose so a clean checkout can run `pytest` — never put a real
# secret here. tests/conftest.py force-loads this file (overriding the shell and
# any developer .env) and refuses to run unless DATABASE_URL points at the
# local test database started by docker-compose.test.yml.
APP_ENV=test
LOG_LEVEL=WARNING
RATE_LIMIT_ENABLED=false
CACHE_ENABLED=false
ENABLE_LOCAL_CHAT_TEST=false
TELEGRAM_ENABLED=false

# Dummy secrets, >= 32 chars.
JWT_SECRET_KEY=test-only-jwt-secret-not-for-real-use-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_PEPPER=test-only-password-pepper-not-for-real-use-0123456789

OPENAI_API_KEY=test-key

# Test Postgres (docker-compose.test.yml, host port 5433)
POSTGRES_USER=dosely_test
POSTGRES_PASSWORD=dosely_test
POSTGRES_DB=dosely_test
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://dosely_test:dosely_test@localhost:5433/dosely_test

# Test Redis (docker-compose.test.yml, host port 6380)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2
