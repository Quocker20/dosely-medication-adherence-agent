*~

# OS
.DS_Store
Thumbs.db

# Data (never commit large data at repo root — do NOT use bare "data/", it
# silently matches nested source dirs too, e.g. the Android data/ package)
# Runtime/generated data stays ignored, except the production Dược Thư index
# required by fresh clones and deployment hosts. Its large payloads use Git LFS.
/data/*
!/data/rag_dense_index_q1_q2/
!/data/rag_dense_index_q1_q2/manifest.json
!/data/rag_dense_index_q1_q2/records.jsonl
!/data/rag_dense_index_q1_q2/vectors.npy
*.db
*.sqlite3
# Scoped to the dataset dir on purpose — a bare "*.pdf" would silently swallow
# spec/report PDFs added under docs/.
/data/**/*.pdf
/data/ocr/
/.tools/

# Logs
logs/
*.log

# Test coverage
htmlcov/
.coverage
coverage.xml

# Docker
docker-compose.override.yml

# Node (frontend)
node_modules/
.next/
out/
.nuxt/
*.tsbuildinfo

# Build
*.pyc
*.pyo

# AI logs — tracked structure, ignored content
.ai-log/*.jsonl
.ai-log/archive/

# AI Configuration
# .agents/ and .codegraph/ are ignored outright — unlike .ai-log/ above, they
# keep no tracked .gitkeep, so the directories do not survive a fresh clone.
.agents/
.codegraph/

# Anchored to the repo root: a bare "package.json" also matches nested
# manifests such as web/package.json.
/package.json

CLAUDE.md

# .claude/ holds per-machine agents, commands, skills and local settings.
# Ignore its contents but keep settings.json tracked — it carries the AI
# logging hooks required by BTC AI20K. The pattern must be ".claude/*", not
# ".claude/": git cannot re-include a file whose parent directory is excluded.
.claude/*
!.claude/settings.json

# Built APK dropped on the server for direct download — not a git artifact
downloads/

# Celery Beat schedule files (auto-generated, machine-specific)
celerybeat-schedule.bak
celerybeat-schedule.dat
celerybeat-schedule.dir

# Local dev / debug scripts (not part of app source)
manage_schedule.py
test_fcm_now.py

# Firebase service account credentials — never commit
firebase-adminsdk.json
.vercel
.env*
