# ============================================
# AI20K Project — Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- Security & JWT ----
JWT_SECRET_KEY=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=
PASSWORD_PEPPER=

# ---- LLM Configuration ----
OPENAI_API_KEY=
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
# Hostnames here are the HOST-side view (running uvicorn/pytest/alembic on your
# machine against `docker compose up postgres redis`). The backend and worker
# containers get the in-network hostnames from docker-compose.yml, which
# overrides these — do not switch them back to `postgres`/`redis` or running
# the test suite outside a container stops resolving.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=
DATABASE_URL=
# For SQLite (development):
# DATABASE_URL=sqlite+aiosqlite:///./data/dev.db

# ---- Redis Cache & Message Broker ----
REDIS_HOST=
REDIS_PORT=
REDIS_URL=

# ---- Response Cache (src/core/cache.py) ----
# CACHE_ENABLED=true
# CACHE_KEY_PREFIX=dosely:cache
# CACHE_TTL_MEDICATIONS_SECONDS=3600
# CACHE_TTL_DASHBOARD_SECONDS=45
# CACHE_TTL_ADHERENCE_CURRENT_SECONDS=60
# CACHE_TTL_ADHERENCE_HISTORICAL_SECONDS=86400

# ---- Celery Task Queue ----
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ---- Vector Store ----
CHROMA_PERSIST_DIR=
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- Backend API (Dosely FastAPI backend) ----
API_BASE_URL=
# SYSTEM-role token for agent tool calls — auth flow for SYSTEM role not yet
# confirmed with backend team, see src/config.py comment.
API_SERVICE_TOKEN=
API_TIMEOUT_SECONDS=

# ---- Speech (STT/TTS) — POST /chat/voice, xem src/services/speech.py ----
STT_MODEL=
TTS_MODEL=
TTS_VOICE=

# ---- App Config ----
APP_ENV=
APP_PORT=
APP_HOST=
CORS_ORIGINS=
ENABLE_LOCAL_CHAT_TEST=false
DEV_CHAT_PATIENT_ID=

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
LANGCHAIN_TRACING_V2=

# ---- Firebase Cloud Messaging (FCM) ----
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=firebase-adminsdk.json

# ---- Logging ----
LOG_LEVEL=


# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:3000
