# ============================================
# AI20K Project — Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- Security & JWT ----
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_PEPPER=

# ---- LLM Configuration ----
OPENAI_API_KEY=
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=adheremind
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/adheremind
# For SQLite (development):
# DATABASE_URL=sqlite+aiosqlite:///./data/dev.db

# ---- Redis Cache & Message Broker ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---- Celery Task Queue ----
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- Backend API (RemindRx FastAPI backend) ----
API_BASE_URL=http://localhost:8000/api/v1
# SYSTEM-role token for agent tool calls — auth flow for SYSTEM role not yet
# confirmed with backend team, see src/config.py comment.
API_SERVICE_TOKEN=
API_TIMEOUT_SECONDS=10

# ---- Speech (STT/TTS) — POST /chat/voice, xem src/services/speech.py ----
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=adhe-remind
LANGCHAIN_TRACING_V2=false

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=
AI_LOG_API_KEY=
AI_LOG_DIR=./logs/ai

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:3000
