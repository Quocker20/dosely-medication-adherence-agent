# ============================================
# AI20K Project — Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- Security & JWT ----
JWT_SECRET_KEY=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

# ---- LLM Configuration ----
OPENAI_API_KEY=
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
# For SQLite (development):
# DATABASE_URL=

# ---- Redis Cache & Message Broker ----
REDIS_HOST=
REDIS_PORT=
REDIS_URL=

# ---- Celery Task Queue ----
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ---- Vector Store ----
CHROMA_PERSIST_DIR=
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=
APP_PORT=
APP_HOST=
CORS_ORIGINS=

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
LANGCHAIN_TRACING_V2=

# ---- Logging ----
LOG_LEVEL=

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=
AI_LOG_API_KEY=
AI_LOG_DIR=

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=
